 extern "C" aclError aclrtSynchronizeStream(aclrtStream stream) {
   Require(capturing_stream!=stream,"raw READ must not synchronize during graph capture");
   ++raw_syncs;
@@ -532,9 +538,40 @@ void SubmissionFailure(const std::string& mode) {
   std::_Exit(0);
 }
 
+void CheckedReadRejectsStaleStatus() {
+  raw_mode=true;fake_device=0;
+  std::vector<uint8_t> source(4096,0x67),output(128);
+  kvaf::HbmReader reader(0,2,2,2048,"fake.o",64,false,true);
+  kvaf::HbmReceiverTicket receiver;
+  Check(reader.Listen("127.0.0.1:0","",reader_eid,&receiver));
+  Proxy proxy(receiver);
+  kvaf::NpuPullHbmSource producer(0,producer_eid);
+  auto stream=reinterpret_cast<void*>(1);
+  Check(producer.Register({source.data(),source.size(),kvaf::DeviceKind::kNpu},proxy.receiver,stream));
+  kvaf::ReadyToken token;
+  int64_t src=7,dst=11,bytes=64;
+  auto read=[&](bool synchronize) {
+    return reader.Read(token,{&src,1},{&dst,1},{&bytes,1},
+                       {output.data(),output.size(),kvaf::DeviceKind::kNpu},
+                       stream,nullptr,false,synchronize);
+  };
+  Check(producer.Ready(&token));
+  Require(!read(false).ok(),"checked READ must wait for device completion");
+  Check(read(true));
+  Check(producer.ReleaseBatch(token));
+  Check(producer.Ready(&token));
+  skip_status_core=1;
+  const auto status=read(true);
+  Require(status.code()==kvaf::StatusCode::kCompletionUnknown && reader.pending() && producer.frozen(),
+          "missing device status cannot reuse a previous successful batch or release the source");
+  Require(!reader.Resolve(token).ok(),"unresolved READ cannot be promoted to completion");
+  std::_Exit(0);  // The unresolved device operation deliberately retains its resources.
+}
+
 int main(int argc,char** argv){try{
   if(argc==2) {
     const std::string mode=argv[1];
+    if(mode=="checked-status") CheckedReadRejectsStaleStatus();
     Require(mode=="launch-failure"||mode=="sync-failure","known ACL fault mode");
     SubmissionFailure(mode);
   }
