 }
+extern "C" aclError aclrtMemsetAsync(void* dst,std::size_t capacity,int value,
+                                     std::size_t bytes,aclrtStream stream) {
+  Require(bytes<=capacity,"reset fits status buffer");
+  EnqueueRawTask(stream,[=]{std::memset(dst,value,bytes);});
