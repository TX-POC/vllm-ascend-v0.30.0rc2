{
  "format": 1,
  "target": "A5C8ExactSpeculativeResidentGet",
  "source_derived_from": {
    "operator": "VllmQuantLightningIndexer",
    "source_root": "csrc/attention/vllm_quant_lightning_indexer",
    "score_seam": {
      "file": "op_kernel/arch35/quant_lightning_indexer_service_vector.h",
      "function": "QLIVector::ProcessVec1",
      "after": "vector1::BatchMulWeightAndReduceSum",
      "before": "DataCopyPad(scoreGm"
    },
    "topk_owner": "official ProcessTopK unchanged"
  },
  "resource_model": {
    "worker_assignment": "any C8 worker may dynamically acquire an invocation-local queue",
    "fixed_get_core_partition": false,
    "persistent_slot_map_mutation_during_score_scan": false,
    "canonical_resident_range": {
      "input": "speculative_resident_slots",
      "dtype": "int32",
      "shape": "[R, 2048]",
      "slot_count": 2048,
      "meaning": "normal resident output slots reserved per C8 row"
    }
  },
  "candidate_seed": {
    "dtype": "int32",
    "words": ["row", "source", "kv_object", "resident_slot"],
    "slot_assignment": "one candidate receives one distinct fixed resident slot before PostOnly",
    "cross_wave_slot_invariant": "CandidateCompact never assigns one resident_slot to two initial waves; Stage-B may reuse a non-winner slot only after every initial wave targeting it is terminal"
  },
  "stage_a": {
    "name": "score_scan_candidate_post",
    "inputs": [
      "official_c8_inputs",
      "resident_threshold",
      "resident_threshold_valid",
      "req_pool_entries",
      "kv_object_map",
      "kv_object_lens",
      "persistent_object_slots_snapshot",
      "speculative_resident_slots",
      "resident_packed_output",
      "layer_resident_get_control"
    ],
    "outputs": [
      "official_sparse_indices",
      "official_sparse_values",
      "candidate_seeds",
      "candidate_counts",
      "initial_post_records"
    ],
    "rule": "observe exact tile scores, compact only cold candidates, and PostOnly to the supplied fixed resident slot without modifying official C8 score or Top-K state"
  },
  "stage_b": {
    "name": "topk_recall_and_terminal_drain",
    "inputs": [
      "official_sparse_indices",
      "candidate_seeds",
      "candidate_counts",
      "initial_post_records",
      "persistent_object_slots_snapshot",
      "speculative_resident_slots",
      "resident_packed_output",
      "layer_resident_get_control"
    ],
    "outputs": ["attention_slots", "terminal_post_stats"],
    "winner_resolution_order": [
      "persistent_resident_slot",
      "terminal_speculative_resident_slot",
      "fixed_slot_after_initial_drain_then_exact_recall"
    ],
    "completion_condition": "all_initial_and_recall_posts_terminal",
    "qsfa_contract": "QSFA consumes only final attention_slots after this condition holds"
  },
  "non_goals": [
    "cross_forward_transport",
    "cross_layer_transport",
    "private_slot_indirection",
    "persistent_directory_updates_before_exact_topk",
    "fixed_physical_get_core_partition"
  ]
}
