    "operator_has_runtime_enable_input": false,
    "operator_has_runtime_off_branch": false
  },
  "stages": {
    "producer": {
      "role": "raw_exact_score_receipt_only",
      "may_issue_hccp": false,
      "may_wait_for_cq": false,
      "may_modify_c8_topk": false,
      "may_read_resident_mapping": false,
